ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stage 02 — cloud LLM for conversation
OPENROUTER_API_KEY=your-key-here
# OPENROUTER_MODEL=

# Stage 02 — decide() backend used by the benchmark: rules | ollama | llm
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=functiongemma
